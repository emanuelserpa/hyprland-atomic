#!/usr/bin/env bash
set -euo pipefail

mode="${1:-output}"
screenshot_dir="${XDG_PICTURES_DIR:-${HOME}/Pictures}/Screenshots"
mkdir -p "$screenshot_dir"
target="$screenshot_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"

case "$mode" in
  output)
    grim "$target"
    ;;
  area)
    geometry="$(slurp)" || exit 0
    [[ -n "$geometry" ]] || exit 0
    grim -g "$geometry" "$target"
    ;;
  *)
    printf 'Usage: %s {output|area}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

wl-copy < "$target"
