# Optional machine-specific overrides. Shared configuration lives in conf.d/.
updateall() {
  if (( $+commands[pacman] )); then
    sudo pacman -Syu --noconfirm || return
  elif (( $+commands[rpm-ostree] )); then
    sudo rpm-ostree upgrade || return
  else
    print -u2 'No supported system package manager found (pacman or rpm-ostree).'
    return 127
  fi

  (( $+commands[flatpak] )) && flatpak update --noninteractive
}
