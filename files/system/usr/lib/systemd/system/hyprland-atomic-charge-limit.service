[Unit]
Description=Apply ThinkPad battery charge protection
Documentation=https://docs.kernel.org/admin-guide/laptops/thinkpad-acpi.html
After=systemd-modules-load.service
ConditionPathExists=/sys/class/power_supply/BAT0/charge_control_start_threshold
ConditionPathExists=/sys/class/power_supply/BAT0/charge_control_end_threshold

[Service]
Type=oneshot
ExecStart=/usr/libexec/hyprland-atomic-charge-limit BAT0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
